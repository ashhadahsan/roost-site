---
const features = [
  {
    title: "Transactional enqueue",
    body: "Pass your connection. INSERT INTO roost.jobs commits inside your transaction. Jobs cannot orphan or vanish — the killer feature you can't get with Redis-backed queues.",
    icon: "🔒",
  },
  {
    title: "FOR UPDATE SKIP LOCKED",
    body: "Multiple workers race for rows safely. SQL-level concurrency means double-processing is structurally impossible, not statistically rare.",
    icon: "⚡",
  },
  {
    title: "Real-time wakeups",
    body: "LISTEN / NOTIFY pings idle workers within milliseconds of an enqueue. No polling overhead, no busy loops.",
    icon: "📡",
  },
  {
    title: "Sync + async, first-class",
    body: "AsyncRoost on asyncpg for FastAPI / Starlette. Roost on psycopg for Django / Flask. Same schema, same SQL, no async-from-sync footguns.",
    icon: "🔀",
  },
  {
    title: "Crash-tolerant",
    body: "Worker SIGKILL'd mid-job? An orphan reaper running in any peer worker drains the row back to retryable. Heartbeats keep the workers table fresh.",
    icon: "🛟",
  },
  {
    title: "Cron + unique jobs + retries",
    body: "Cluster-singleton cron via advisory lock. Partial unique index on active states. Exponential / linear / fixed backoff plus snooze and timeouts.",
    icon: "⏱",
  },
  {
    title: "Per-task throttling",
    body: "rate_per_minute and max_concurrency on @job, enforced inside the fetch SQL. A single batch never over-picks a throttled task.",
    icon: "🎚",
  },
  {
    title: "Job chaining",
    body: "depends_on=[parent_id] gates a child until every parent completes. Parent failures cascade — blocked dependents auto-cancel.",
    icon: "🔗",
  },
  {
    title: "Observable by SQL today",
    body: "SELECT * FROM roost.jobs WHERE state = 'discarded'. OpenTelemetry hooks and Prometheus counters when you want them; no-op when you don't.",
    icon: "🔎",
  },
];
---

<section class="border-b border-roost-border/70 py-24">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight">What you get</h2>
    <p class="mt-3 text-roost-muted max-w-2xl">
      Roost picks up where procrastinate and pgqueuer left off — they got the schema right, we add the polish: dashboards, hooks, throttling, chaining, contrib helpers for FastAPI / Django / Flask.
    </p>
    <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        features.map((f) => (
          <article class="rounded-xl border border-roost-border bg-roost-card p-6 hover:border-roost-accent/60 transition">
            <div class="text-2xl">{f.icon}</div>
            <h3 class="mt-3 font-semibold text-roost-fg text-lg">{f.title}</h3>
            <p class="mt-2 text-sm text-roost-muted leading-relaxed">{f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
